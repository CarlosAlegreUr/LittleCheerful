<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LittleCheerful.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:LittleCheerful.Maui.Views"
    Title="Little Cheerful"
    BackgroundColor="{StaticResource Parchment}"
    Shell.TabBarBackgroundColor="{StaticResource ParchmentDark}"
    Shell.TabBarTitleColor="{StaticResource InkBrown}"
    Shell.TabBarUnselectedColor="{StaticResource Gray500}"
    Shell.TabBarForegroundColor="{StaticResource Crimson}"
    Shell.ForegroundColor="{StaticResource Crimson}">

    <TabBar>
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate views:HomePage}"
            Route="home" />

        <ShellContent
            Title="Knowledge Tree"
            ContentTemplate="{DataTemplate views:TreePage}"
            Route="tree" />

        <ShellContent
            Title="Materials"
            ContentTemplate="{DataTemplate views:MaterialsPage}"
            Route="materials" />

        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
