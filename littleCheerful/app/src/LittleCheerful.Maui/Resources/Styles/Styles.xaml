<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- =============================================== -->
    <!-- Spacing Resources                              -->
    <!-- =============================================== -->
    <Thickness x:Key="PaddingXS">4</Thickness>
    <Thickness x:Key="PaddingSM">8</Thickness>
    <Thickness x:Key="PaddingMD">16</Thickness>
    <Thickness x:Key="PaddingLG">24</Thickness>
    <Thickness x:Key="PaddingXL">32</Thickness>
    <Thickness x:Key="PaddingXXL">48</Thickness>

    <Thickness x:Key="PageMargin">24,32,24,24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="ChatBubblePadding">12,10</Thickness>

    <!-- =============================================== -->
    <!-- Corner Radius Resources                        -->
    <!-- =============================================== -->
    <CornerRadius x:Key="RadiusSM">4</CornerRadius>
    <CornerRadius x:Key="RadiusMD">8</CornerRadius>
    <CornerRadius x:Key="RadiusLG">12</CornerRadius>
    <CornerRadius x:Key="RadiusXL">16</CornerRadius>
    <CornerRadius x:Key="RadiusRound">24</CornerRadius>

    <!-- =============================================== -->
    <!-- Base Page Style                                -->
    <!-- =============================================== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Parchment}" />
    </Style>

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Parchment}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{StaticResource Parchment}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{StaticResource ParchmentDark}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{StaticResource InkBrown}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{StaticResource Gray500}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{StaticResource Crimson}" />
    </Style>

    <!-- =============================================== -->
    <!-- Typography Styles                              -->
    <!-- =============================================== -->

    <!-- Display Text - Large Titles (32sp, Bold) -->
    <Style x:Key="DisplayText" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource InkBlack}" />
    </Style>

    <!-- H1 - Section Headers (28sp, Bold) -->
    <Style x:Key="H1Text" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource InkBlack}" />
    </Style>

    <!-- H2 - Card Titles (24sp, SemiBold) -->
    <Style x:Key="H2Text" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource InkBlack}" />
    </Style>

    <!-- H3 - Subsections (20sp) -->
    <Style x:Key="H3Text" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource InkBrown}" />
    </Style>

    <!-- Oracle Text - AI Messages (18sp, Serif) -->
    <Style x:Key="OracleText" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource InkBrown}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <!-- Body Text - General Content (16sp) -->
    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource InkBlack}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>

    <!-- Body Small - Secondary Text (14sp) -->
    <Style x:Key="BodySmallText" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource InkBrown}" />
    </Style>

    <!-- Caption Text - Tags, Hints (12sp) -->
    <Style x:Key="CaptionText" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextColor" Value="{StaticResource Gray600}" />
    </Style>

    <!-- Gold Display Text - Special Titles -->
    <Style x:Key="GoldDisplayText" TargetType="Label">
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource GoldLight}" />
    </Style>

    <!-- Default Label Style -->
    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource InkBlack}" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- =============================================== -->
    <!-- Button Styles                                  -->
    <!-- =============================================== -->

    <!-- Roman Button - Primary (Crimson with Gold Border) -->
    <Style x:Key="RomanButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Crimson}" />
        <Setter Property="TextColor" Value="{StaticResource MarbleWhite}" />
        <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Crimson}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CrimsonLight}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CrimsonDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Gray400}" />
                            <Setter Property="BorderColor" Value="{StaticResource Gray500}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Roman Button - Secondary (Outlined) -->
    <Style x:Key="RomanButtonSecondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource Crimson}" />
        <Setter Property="BorderColor" Value="{StaticResource Crimson}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ParchmentLight}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource ParchmentDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{StaticResource Gray400}" />
                            <Setter Property="BorderColor" Value="{StaticResource Gray400}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Gold Button - Success/Positive Actions -->
    <Style x:Key="GoldButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource GoldAccent}" />
        <Setter Property="TextColor" Value="{StaticResource InkBlack}" />
        <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <!-- Default Button Style -->
    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Crimson}" />
        <Setter Property="TextColor" Value="{StaticResource MarbleWhite}" />
        <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
        <Setter Property="BorderWidth" Value="1.5" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Crimson}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CrimsonLight}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource CrimsonDark}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Gray400}" />
                            <Setter Property="BorderColor" Value="{StaticResource Gray500}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- =============================================== -->
    <!-- Frame/Card Styles                              -->
    <!-- =============================================== -->

    <!-- Scroll Card - Parchment Card with Shadow -->
    <Style x:Key="ScrollCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ParchmentLight}" />
        <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- Marble Card - White Surface Card -->
    <Style x:Key="MarbleCard" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource MarbleWhite}" />
        <Setter Property="BorderColor" Value="{StaticResource MarbleGray}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- Default Frame Style -->
    <Style TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ParchmentLight}" />
        <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- =============================================== -->
    <!-- Entry/Editor Styles                            -->
    <!-- =============================================== -->

    <Style TargetType="Entry">
        <Setter Property="BackgroundColor" Value="{StaticResource ParchmentLight}" />
        <Setter Property="TextColor" Value="{StaticResource InkBlack}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="BackgroundColor" Value="{StaticResource ParchmentLight}" />
        <Setter Property="TextColor" Value="{StaticResource InkBlack}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource Gray500}" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- =============================================== -->
    <!-- Picker Style                                   -->
    <!-- =============================================== -->

    <Style TargetType="Picker">
        <Setter Property="BackgroundColor" Value="{StaticResource ParchmentLight}" />
        <Setter Property="TextColor" Value="{StaticResource InkBlack}" />
        <Setter Property="TitleColor" Value="{StaticResource InkBrown}" />
        <Setter Property="FontFamily" Value="Georgia" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- =============================================== -->
    <!-- ProgressBar Style                              -->
    <!-- =============================================== -->

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{StaticResource GoldAccent}" />
    </Style>

    <!-- =============================================== -->
    <!-- Slider Style                                   -->
    <!-- =============================================== -->

    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{StaticResource GoldAccent}" />
        <Setter Property="MaximumTrackColor" Value="{StaticResource ParchmentDark}" />
        <Setter Property="ThumbColor" Value="{StaticResource Crimson}" />
    </Style>

    <!-- =============================================== -->
    <!-- ActivityIndicator Style                        -->
    <!-- =============================================== -->

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource GoldAccent}" />
    </Style>

    <!-- =============================================== -->
    <!-- BoxView Divider Style                          -->
    <!-- =============================================== -->

    <Style x:Key="Divider" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource GoldDark}" />
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- =============================================== -->
    <!-- Chat Bubble Styles                             -->
    <!-- =============================================== -->

    <!-- Oracle Chat Bubble (Left-aligned, Marble) -->
    <Style x:Key="OracleBubble" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource MarbleWhite}" />
        <Setter Property="BorderColor" Value="{StaticResource MarbleGray}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Margin" Value="5,5,50,5" />
    </Style>

    <!-- User Chat Bubble (Right-aligned, Parchment) -->
    <Style x:Key="UserBubble" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ParchmentLight}" />
        <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="HasShadow" Value="True" />
        <Setter Property="Margin" Value="50,5,5,5" />
    </Style>

    <!-- System Message Bubble (Centered, Warning) -->
    <Style x:Key="SystemBubble" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ParchmentDark}" />
        <Setter Property="BorderColor" Value="{StaticResource WarningAmber}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="Margin" Value="20,5" />
    </Style>

    <!-- =============================================== -->
    <!-- Tag Chip Styles                                -->
    <!-- =============================================== -->

    <Style x:Key="TagChipIntuitive" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource TagIntuitive}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="HeightRequest" Value="24" />
    </Style>

    <Style x:Key="TagChipFormal" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource TagFormal}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="HeightRequest" Value="24" />
    </Style>

    <Style x:Key="TagChipCanApply" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource TagCanApply}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HasShadow" Value="False" />
        <Setter Property="HeightRequest" Value="24" />
    </Style>

    <!-- =============================================== -->
    <!-- Three Option Panel Style                       -->
    <!-- =============================================== -->

    <Style x:Key="OptionLoopPanel" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ParchmentDark}" />
        <Setter Property="BorderColor" Value="{StaticResource GoldAccent}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- =============================================== -->
    <!-- Concept Node Styles                            -->
    <!-- =============================================== -->

    <Style x:Key="ConceptNodeNotStarted" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource NodeNotStarted}" />
        <Setter Property="BorderColor" Value="{StaticResource InkBrown}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="ConceptNodeInProgress" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource NodeInProgress}" />
        <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <Style x:Key="ConceptNodeStudied" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource NodeStudied}" />
        <Setter Property="BorderColor" Value="{StaticResource NodeStudied}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="HasShadow" Value="True" />
    </Style>

    <!-- =============================================== -->
    <!-- Step Indicator Styles                          -->
    <!-- =============================================== -->

    <Style x:Key="StepCircleActive" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource GoldAccent}" />
        <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="StepCircleInactive" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource ParchmentLight}" />
        <Setter Property="BorderColor" Value="{StaticResource InkBrown}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

    <Style x:Key="StepCircleCompleted" TargetType="Frame">
        <Setter Property="BackgroundColor" Value="{StaticResource NodeStudied}" />
        <Setter Property="BorderColor" Value="{StaticResource NodeStudied}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HasShadow" Value="False" />
    </Style>

</ResourceDictionary>
