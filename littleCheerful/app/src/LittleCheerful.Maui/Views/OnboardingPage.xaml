<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LittleCheerful.Maui.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="LittleCheerful.Maui.Views.OnboardingPage"
             x:DataType="viewmodels:OnboardingViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Parchment}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PageMargin}">

        <!-- Step Indicator Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="16">

            <!-- Progress Bar as Step Indicator -->
            <Frame BackgroundColor="{StaticResource ParchmentLight}"
                   BorderColor="{StaticResource GoldDark}"
                   Padding="16"
                   CornerRadius="8"
                   HorizontalOptions="Center">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="4">
                        <Label Text="Step"
                               Style="{StaticResource BodySmallText}" />
                        <Label Text="{Binding CurrentStep, StringFormat='{0}'}"
                               Style="{StaticResource BodyText}"
                               FontAttributes="Bold"
                               TextColor="{StaticResource GoldDark}" />
                        <Label Text="of 6"
                               Style="{StaticResource BodySmallText}" />
                    </HorizontalStackLayout>
                    <ProgressBar Progress="{Binding StepProgress}"
                                 ProgressColor="{StaticResource GoldAccent}"
                                 WidthRequest="200" />
                </VerticalStackLayout>
            </Frame>

            <!-- Step Title -->
            <Label Text="{Binding StepTitle}"
                   Style="{StaticResource H2Text}"
                   HorizontalOptions="Center" />

            <!-- Step Description -->
            <Label Text="{Binding StepDescription}"
                   Style="{StaticResource BodyText}"
                   TextColor="{StaticResource InkBrown}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Step Content in Scroll Card -->
        <ScrollView Grid.Row="1" Padding="0,20">
            <Frame Style="{StaticResource ScrollCard}" Margin="0,10">
                <VerticalStackLayout Spacing="15">

                    <!-- Error Message -->
                    <Frame IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullConverter}}"
                           BackgroundColor="{StaticResource ErrorInk}"
                           BorderColor="{StaticResource Crimson}"
                           Padding="12" CornerRadius="8">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{StaticResource MarbleWhite}"
                               HorizontalOptions="Center" />
                    </Frame>

                    <!-- Loading -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="{StaticResource GoldAccent}"
                                       HorizontalOptions="Center" />

                    <!-- Step 0: Teaching Tone -->
                    <VerticalStackLayout IsVisible="False" Spacing="12">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentStep}" Value="0">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label Text="How would you like the Oracle to speak with you?"
                               Style="{StaticResource BodyText}" />
                        <Picker ItemsSource="{Binding ToneOptions}"
                                SelectedItem="{Binding SelectedTone}" />

                        <Entry Placeholder="Describe your preferred tone..."
                               Text="{Binding CustomToneDescription}"
                               IsVisible="False">
                            <Entry.Triggers>
                                <DataTrigger TargetType="Entry" Binding="{Binding SelectedTone}" Value="Other">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Entry.Triggers>
                        </Entry>
                    </VerticalStackLayout>

                    <!-- Step 1: Motivation Style -->
                    <VerticalStackLayout IsVisible="False" Spacing="12">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentStep}" Value="1">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label Text="What motivates you to keep learning?"
                               Style="{StaticResource BodyText}" />
                        <Picker ItemsSource="{Binding MotivationOptions}"
                                SelectedItem="{Binding SelectedMotivation}" />
                    </VerticalStackLayout>

                    <!-- Step 2: Source Depth -->
                    <VerticalStackLayout IsVisible="False" Spacing="12">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentStep}" Value="2">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label Text="How deeply should the Oracle cite sources?"
                               Style="{StaticResource BodyText}" />
                        <Slider Minimum="1" Maximum="4" Value="{Binding SourceDepth}" />
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="Level:"
                                   Style="{StaticResource BodySmallText}" />
                            <Label Text="{Binding SourceDepth, StringFormat='{0:F0}'}"
                                   Style="{StaticResource BodyText}"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource GoldDark}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>

                    <!-- Step 3: Terminology Level -->
                    <VerticalStackLayout IsVisible="False" Spacing="12">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentStep}" Value="3">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label Text="What level of terminology do you prefer?"
                               Style="{StaticResource BodyText}" />
                        <Picker ItemsSource="{Binding TerminologyOptions}"
                                SelectedItem="{Binding SelectedTerminology}" />
                    </VerticalStackLayout>

                    <!-- Step 4: Example Preference -->
                    <VerticalStackLayout IsVisible="False" Spacing="12">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentStep}" Value="4">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label Text="How should the Oracle explain concepts?"
                               Style="{StaticResource BodyText}" />
                        <Picker ItemsSource="{Binding ExampleOptions}"
                                SelectedItem="{Binding SelectedExamples}" />
                    </VerticalStackLayout>

                    <!-- Step 5: Language -->
                    <VerticalStackLayout IsVisible="False" Spacing="12">
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding CurrentStep}" Value="5">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>

                        <Label Text="In which language shall the Oracle speak?"
                               Style="{StaticResource BodyText}" />
                        <Picker ItemsSource="{Binding LanguageOptions}"
                                SelectedItem="{Binding PreferredLanguage}" />
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>
        </ScrollView>

        <!-- Navigation Buttons -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="12" Margin="0,16,0,0">
            <Button Grid.Column="0"
                    Text="Back"
                    Style="{StaticResource RomanButtonSecondary}"
                    Command="{Binding BackCommand}"
                    IsVisible="{Binding CanGoBack}" />

            <Button Grid.Column="1"
                    Text="Skip"
                    Style="{StaticResource RomanButtonSecondary}"
                    Command="{Binding SkipCommand}" />

            <Button Grid.Column="2"
                    Text="{Binding IsLastStep, Converter={toolkit:BoolToObjectConverter TrueObject='Complete', FalseObject='Continue'}}"
                    Style="{StaticResource RomanButton}"
                    Command="{Binding NextCommand}" />
        </Grid>
    </Grid>
</ContentPage>
