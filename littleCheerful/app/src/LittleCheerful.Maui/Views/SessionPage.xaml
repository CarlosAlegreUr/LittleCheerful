<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LittleCheerful.Maui.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="LittleCheerful.Maui.Views.SessionPage"
             x:DataType="viewmodels:SessionViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource MarbleGray}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="16">

        <!-- Decorative candle glows -->
        <BoxView Grid.RowSpan="4"
                 Color="{StaticResource Candlelight}"
                 Opacity="0.06"
                 WidthRequest="100"
                 HeightRequest="100"
                 CornerRadius="50"
                 HorizontalOptions="Start"
                 VerticalOptions="Start"
                 Margin="-30,-30,0,0" />

        <BoxView Grid.RowSpan="4"
                 Color="{StaticResource Candlelight}"
                 Opacity="0.06"
                 WidthRequest="100"
                 HeightRequest="100"
                 CornerRadius="50"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-30,-30,0" />

        <!-- Header -->
        <Frame Grid.Row="0"
               BackgroundColor="{StaticResource ParchmentDark}"
               BorderColor="{StaticResource GoldDark}"
               Padding="12"
               CornerRadius="8"
               Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        Text="Exit"
                        Style="{StaticResource RomanButtonSecondary}"
                        Command="{Binding GoBackCommand}"
                        HeightRequest="40"
                        Padding="12,0" />

                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="Dialogue with the Oracle"
                           Style="{StaticResource H3Text}"
                           HorizontalOptions="Center" />
                    <Label Text="{Binding GoalName}"
                           Style="{StaticResource CaptionText}"
                           TextColor="{StaticResource InkBrown}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <Button Grid.Column="2"
                        Text="Tree"
                        Style="{StaticResource RomanButtonSecondary}"
                        HeightRequest="40"
                        Padding="12,0" />
            </Grid>
        </Frame>

        <!-- Messages List -->
        <Frame Grid.Row="1"
               BackgroundColor="{StaticResource MarbleWhite}"
               BorderColor="{StaticResource MarbleGray}"
               Padding="8"
               CornerRadius="12">
            <CollectionView ItemsSource="{Binding Messages}"
                            x:Name="MessagesCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:ChatMessageViewModel">
                        <!-- Dynamic bubble based on role -->
                        <Frame Margin="8,6" Padding="14,12" CornerRadius="12" HasShadow="True"
                               BackgroundColor="{StaticResource MarbleWhite}"
                               BorderColor="{StaticResource MarbleGray}"
                               HorizontalOptions="Start">

                            <Frame.Triggers>
                                <!-- User messages: Right-aligned, parchment -->
                                <DataTrigger TargetType="Frame" Binding="{Binding IsUser}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource ParchmentLight}" />
                                    <Setter Property="BorderColor" Value="{StaticResource GoldDark}" />
                                    <Setter Property="HorizontalOptions" Value="End" />
                                    <Setter Property="Margin" Value="60,6,8,6" />
                                </DataTrigger>
                                <!-- Oracle/Assistant messages: Left-aligned, marble -->
                                <DataTrigger TargetType="Frame" Binding="{Binding IsAssistant}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource MarbleWhite}" />
                                    <Setter Property="BorderColor" Value="{StaticResource MarbleGray}" />
                                    <Setter Property="HorizontalOptions" Value="Start" />
                                    <Setter Property="Margin" Value="8,6,60,6" />
                                </DataTrigger>
                                <!-- System messages: Centered, warning -->
                                <DataTrigger TargetType="Frame" Binding="{Binding IsSystem}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource ParchmentDark}" />
                                    <Setter Property="BorderColor" Value="{StaticResource WarningAmber}" />
                                    <Setter Property="HorizontalOptions" Value="Center" />
                                    <Setter Property="Margin" Value="30,6" />
                                </DataTrigger>
                            </Frame.Triggers>

                            <VerticalStackLayout Spacing="6">
                                <!-- Role label for Oracle -->
                                <Label Text="The Oracle speaks:"
                                       Style="{StaticResource CaptionText}"
                                       TextColor="{StaticResource GoldDark}"
                                       FontAttributes="Italic"
                                       IsVisible="{Binding IsAssistant}" />

                                <!-- Message content -->
                                <Label Text="{Binding Content}"
                                       Style="{StaticResource BodyText}"
                                       TextColor="{StaticResource InkBlack}"
                                       LineBreakMode="WordWrap" />

                                <!-- Timestamp -->
                                <Label Text="{Binding TimeDisplay}"
                                       Style="{StaticResource CaptionText}"
                                       TextColor="{StaticResource Gray500}"
                                       HorizontalOptions="End" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Frame>

        <!-- Streaming Text Display -->
        <Frame Grid.Row="1"
               Style="{StaticResource OracleBubble}"
               IsVisible="{Binding IsStreaming}"
               VerticalOptions="End"
               Margin="8,0,60,8">
            <VerticalStackLayout Spacing="4">
                <Label Text="The Oracle speaks:"
                       Style="{StaticResource CaptionText}"
                       TextColor="{StaticResource GoldDark}"
                       FontAttributes="Italic" />
                <Label Text="{Binding StreamingText}"
                       Style="{StaticResource BodyText}" />
                <HorizontalStackLayout Spacing="4">
                    <ActivityIndicator IsRunning="True"
                                       Color="{StaticResource GoldAccent}"
                                       WidthRequest="16"
                                       HeightRequest="16" />
                    <Label Text="..."
                           Style="{StaticResource CaptionText}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Frame>

        <!-- Three Option Panel -->
        <Frame Grid.Row="2"
               Style="{StaticResource OptionLoopPanel}"
               IsVisible="{Binding ShowThreeOptions}"
               Margin="0,8">
            <VerticalStackLayout Spacing="16">
                <Label Text="{Binding ThreeOptionState.Acknowledgment}"
                       Style="{StaticResource OracleText}"
                       FontAttributes="Italic"
                       HorizontalTextAlignment="Center" />

                <Label Text="Choose your path:"
                       Style="{StaticResource BodySmallText}"
                       TextColor="{StaticResource GoldDark}"
                       HorizontalOptions="Center" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                    <Button Grid.Column="0"
                            Text="Think More"
                            Style="{StaticResource RomanButtonSecondary}"
                            Command="{Binding ThinkMoreCommand}"
                            FontSize="12"
                            Padding="8,0" />

                    <Button Grid.Column="1"
                            Text="Get Hint"
                            Style="{StaticResource GoldButton}"
                            Command="{Binding GetHintCommand}"
                            FontSize="12"
                            Padding="8,0" />

                    <Button Grid.Column="2"
                            Text="Explain"
                            Style="{StaticResource RomanButton}"
                            Command="{Binding HearExplanationCommand}"
                            FontSize="12"
                            Padding="8,0" />
                </Grid>
            </VerticalStackLayout>
        </Frame>

        <!-- Input Area -->
        <Frame Grid.Row="3"
               BackgroundColor="{StaticResource ParchmentLight}"
               BorderColor="{StaticResource GoldDark}"
               Padding="12"
               CornerRadius="12"
               Margin="0,8,0,0">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                <!-- Error Message -->
                <Label Grid.Row="0"
                       Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource ErrorInk}"
                       Style="{StaticResource CaptionText}"
                       IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullConverter}}" />

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Entry Grid.Column="0"
                           Placeholder="Inscribe your thoughts..."
                           Text="{Binding CurrentMessage}"
                           IsEnabled="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}"
                           ReturnCommand="{Binding SendMessageCommand}"
                           BackgroundColor="{StaticResource MarbleWhite}"
                           FontFamily="Georgia"
                           FontSize="16" />

                    <Button Grid.Column="1"
                            Text="Send"
                            Style="{StaticResource RomanButton}"
                            Command="{Binding SendMessageCommand}"
                            IsEnabled="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}"
                            WidthRequest="80" />
                </Grid>
            </Grid>
        </Frame>

        <!-- Loading Indicator Overlay -->
        <ActivityIndicator Grid.Row="3"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="{StaticResource GoldAccent}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
