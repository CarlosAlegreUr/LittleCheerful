<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LittleCheerful.Maui.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="LittleCheerful.Maui.Views.TreePage"
             x:DataType="viewmodels:TreeViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Parchment}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,16">
            <Label Text="Knowledge Tree"
                   Style="{StaticResource H1Text}"
                   HorizontalOptions="Center" />

            <Label Text="{Binding GoalName}"
                   Style="{StaticResource OracleText}"
                   FontAttributes="Italic"
                   HorizontalOptions="Center" />

            <!-- Legend -->
            <Frame BackgroundColor="{StaticResource ParchmentLight}"
                   BorderColor="{StaticResource GoldDark}"
                   Padding="12"
                   CornerRadius="8"
                   HorizontalOptions="Center"
                   Margin="0,8,0,0">
                <HorizontalStackLayout Spacing="16">
                    <HorizontalStackLayout Spacing="4">
                        <BoxView Color="{StaticResource NodeNotStarted}"
                                 WidthRequest="16" HeightRequest="16"
                                 CornerRadius="8" />
                        <Label Text="Not Started"
                               Style="{StaticResource CaptionText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <BoxView Color="{StaticResource NodeInProgress}"
                                 WidthRequest="16" HeightRequest="16"
                                 CornerRadius="8" />
                        <Label Text="In Progress"
                               Style="{StaticResource CaptionText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="4">
                        <BoxView Color="{StaticResource NodeStudied}"
                                 WidthRequest="16" HeightRequest="16"
                                 CornerRadius="8" />
                        <Label Text="Studied"
                               Style="{StaticResource CaptionText}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </Frame>

            <!-- Error Message -->
            <Frame IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullConverter}}"
                   BackgroundColor="{StaticResource ErrorInk}"
                   BorderColor="{StaticResource Crimson}"
                   Padding="12" CornerRadius="8">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource MarbleWhite}"
                       HorizontalOptions="Center" />
            </Frame>
        </VerticalStackLayout>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="16">
            <!-- Tree List -->
            <Frame Grid.Column="0"
                   Style="{StaticResource ScrollCard}"
                   Padding="8">
                <CollectionView ItemsSource="{Binding Nodes}"
                                SelectedItem="{Binding SelectedNode}"
                                SelectionMode="Single"
                                SelectionChangedCommand="{Binding SelectConceptCommand}"
                                SelectionChangedCommandParameter="{Binding SelectedNode}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:ConceptNodeViewModel">
                            <Frame Padding="12" Margin="4" CornerRadius="8"
                                   BackgroundColor="{StaticResource ParchmentLight}"
                                   BorderColor="{StaticResource GoldDark}">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <!-- Status Indicator -->
                                    <Frame Grid.Column="0"
                                           WidthRequest="12"
                                           HeightRequest="12"
                                           CornerRadius="6"
                                           Padding="0"
                                           HasShadow="False"
                                           VerticalOptions="Center"
                                           BackgroundColor="{StaticResource NodeNotStarted}">
                                        <Frame.Triggers>
                                            <DataTrigger TargetType="Frame" Binding="{Binding StatusDisplay}" Value="In Progress">
                                                <Setter Property="BackgroundColor" Value="{StaticResource NodeInProgress}" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Frame" Binding="{Binding StatusDisplay}" Value="Studied">
                                                <Setter Property="BackgroundColor" Value="{StaticResource NodeStudied}" />
                                            </DataTrigger>
                                        </Frame.Triggers>
                                    </Frame>

                                    <!-- Node Info -->
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding DisplayName}"
                                               Style="{StaticResource BodyText}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource InkBlack}" />
                                        <Label Text="{Binding StatusDisplay}"
                                               Style="{StaticResource CaptionText}"
                                               TextColor="{StaticResource InkBrown}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="16">
                            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                               IsVisible="{Binding IsLoading}"
                                               Color="{StaticResource GoldAccent}" />
                            <Label Text="No concepts discovered yet..."
                                   IsVisible="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}"
                                   Style="{StaticResource OracleText}"
                                   FontAttributes="Italic"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Frame>

            <!-- Detail Panel -->
            <Frame Grid.Column="1"
                   Style="{StaticResource MarbleCard}">
                <ScrollView>
                    <VerticalStackLayout Spacing="16"
                                         IsVisible="{Binding SelectedConcept, Converter={toolkit:IsNotNullConverter}}">

                        <!-- Concept Name -->
                        <Label Text="{Binding SelectedConcept.Name}"
                               Style="{StaticResource H2Text}"
                               TextColor="{StaticResource InkBlack}" />

                        <!-- Status Badge -->
                        <Frame Padding="8,4"
                               CornerRadius="12"
                               HasShadow="False"
                               HorizontalOptions="Start"
                               BackgroundColor="{StaticResource NodeNotStarted}">
                            <Label Text="{Binding SelectedConcept.Status}"
                                   Style="{StaticResource CaptionText}"
                                   TextColor="{StaticResource MarbleWhite}" />
                        </Frame>

                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Overview -->
                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding SelectedConcept.Overview, Converter={toolkit:IsNotNullConverter}}">
                            <Label Text="Overview"
                                   Style="{StaticResource H3Text}"
                                   TextColor="{StaticResource GoldDark}" />
                            <Label Text="{Binding SelectedConcept.Overview}"
                                   Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>

                        <!-- Explanation -->
                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding SelectedConcept.Explanation, Converter={toolkit:IsNotNullConverter}}">
                            <Label Text="Explanation"
                                   Style="{StaticResource H3Text}"
                                   TextColor="{StaticResource GoldDark}" />
                            <Label Text="{Binding SelectedConcept.Explanation}"
                                   Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>

                        <BoxView Style="{StaticResource Divider}" />

                        <!-- Action Buttons -->
                        <VerticalStackLayout Spacing="12">
                            <Button Text="Begin Study Session"
                                    Style="{StaticResource RomanButton}"
                                    Command="{Binding StartSessionCommand}"
                                    HorizontalOptions="Fill" />

                            <Button Text="Break Down Further"
                                    Style="{StaticResource RomanButtonSecondary}"
                                    Command="{Binding BreakdownConceptCommand}"
                                    HorizontalOptions="Fill" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Frame>
        </Grid>

        <!-- Footer -->
        <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="16" Margin="0,16,0,0">
            <Button Text="Refresh Tree"
                    Style="{StaticResource RomanButtonSecondary}"
                    Command="{Binding LoadTreeCommand}" />
            <Button Text="New Goal"
                    Style="{StaticResource RomanButton}"
                    Command="{Binding CreateNewGoalCommand}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
