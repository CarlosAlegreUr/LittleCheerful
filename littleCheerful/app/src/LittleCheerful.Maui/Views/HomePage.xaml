<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:LittleCheerful.Maui.ViewModels"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="LittleCheerful.Maui.Views.HomePage"
             x:DataType="viewmodels:HomeViewModel"
             Title="{Binding Title}"
             BackgroundColor="{StaticResource Parchment}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior EventName="Appearing" Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,*,Auto" Padding="{StaticResource PageMargin}">

        <!-- Decorative candle glows in corners -->
        <BoxView Grid.RowSpan="3"
                 Color="{StaticResource Candlelight}"
                 Opacity="0.08"
                 WidthRequest="120"
                 HeightRequest="120"
                 CornerRadius="60"
                 HorizontalOptions="Start"
                 VerticalOptions="Start"
                 Margin="-40,-40,0,0" />

        <BoxView Grid.RowSpan="3"
                 Color="{StaticResource Candlelight}"
                 Opacity="0.08"
                 WidthRequest="120"
                 HeightRequest="120"
                 CornerRadius="60"
                 HorizontalOptions="End"
                 VerticalOptions="Start"
                 Margin="0,-40,-40,0" />

        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Spacing="8">
            <!-- Oracle Book Icon -->
            <Frame BackgroundColor="{StaticResource MarbleWhite}"
                   BorderColor="{StaticResource GoldAccent}"
                   CornerRadius="50"
                   WidthRequest="100"
                   HeightRequest="100"
                   HorizontalOptions="Center"
                   Padding="0"
                   HasShadow="True">
                <Label Text="&#128214;"
                       FontSize="50"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>

            <!-- Greeting -->
            <Label Text="{Binding Greeting}"
                   Style="{StaticResource H1Text}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,16,0,0" />

            <!-- Oracle message -->
            <Label Text="The Oracle awaits your inquiry..."
                   Style="{StaticResource OracleText}"
                   FontAttributes="Italic"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <!-- Main Content -->
        <VerticalStackLayout Grid.Row="1"
                             VerticalOptions="Center"
                             Spacing="20">

            <!-- Loading Indicator -->
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource GoldAccent}"
                               HorizontalOptions="Center"
                               WidthRequest="48"
                               HeightRequest="48" />

            <!-- Error Message -->
            <Frame IsVisible="{Binding ErrorMessage, Converter={toolkit:IsNotNullConverter}}"
                   BackgroundColor="{StaticResource ErrorInk}"
                   BorderColor="{StaticResource Crimson}"
                   Padding="16" CornerRadius="8"
                   HorizontalOptions="Center">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource MarbleWhite}"
                       Style="{StaticResource BodyText}"
                       HorizontalOptions="Center" />
            </Frame>

            <!-- Current Goal Card (if active) -->
            <Frame Style="{StaticResource ScrollCard}"
                   IsVisible="{Binding HasGoal}"
                   Margin="0,10">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Current Journey"
                           Style="{StaticResource H3Text}"
                           TextColor="{StaticResource GoldDark}" />

                    <Label Text="{Binding CurrentGoalName}"
                           Style="{StaticResource BodyText}"
                           FontAttributes="Bold" />

                    <!-- Progress Bar -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <ProgressBar Grid.Column="0"
                                     Progress="0.65"
                                     ProgressColor="{StaticResource GoldAccent}"
                                     VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="65%"
                               Style="{StaticResource BodySmallText}"
                               TextColor="{StaticResource GoldDark}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Action Buttons -->
            <VerticalStackLayout Spacing="16"
                                 IsVisible="{Binding IsLoading, Converter={toolkit:InvertedBoolConverter}}">

                <Button Text="Begin New Journey"
                        Style="{StaticResource RomanButton}"
                        Command="{Binding StartNewGoalCommand}"
                        HorizontalOptions="Center"
                        MinimumWidthRequest="250" />

                <Button Text="Continue Learning"
                        Style="{StaticResource GoldButton}"
                        Command="{Binding ContinueLearningCommand}"
                        IsVisible="{Binding HasGoal}"
                        HorizontalOptions="Center"
                        MinimumWidthRequest="250" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Footer Navigation -->
        <HorizontalStackLayout Grid.Row="2"
                               HorizontalOptions="End"
                               Spacing="12">
            <Button Text="Settings"
                    Style="{StaticResource RomanButtonSecondary}"
                    Command="{Binding GoToSettingsCommand}" />
        </HorizontalStackLayout>
    </Grid>
</ContentPage>
